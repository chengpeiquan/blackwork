{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_DIST_DIR", "NEXT_OUTPUT"],
      "outputs": [
        "dist/**",
        ".next-build/**",
        ".next-static/**",
        ".blackwork/**"
      ]
    },
    "build:static": {
      "dependsOn": ["^build"],
      "outputs": [".next-static/**", ".blackwork/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "start:static": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    }
  },
  "ui": "tui"
}
