{
  "name": "blackwork-workspace",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "type": "module",
  "scripts": {
    "docs-starter:dev": "turbo run dev --filter @blackwork/docs-starter",
    "docs-starter:build": "turbo run build --filter @blackwork/docs-starter",
    "docs-starter:build:static": "turbo run build:static --filter @blackwork/docs-starter",
    "docs-starter:preview:static": "pnpm run docs-starter:build:static && pnpm run docs-starter:start:static",
    "docs-starter:start": "turbo run start --filter @blackwork/docs-starter",
    "docs-starter:start:static": "turbo run start:static --filter @blackwork/docs-starter",
    "docs-starter:test": "turbo run test --filter @blackwork/docs-starter",
    "build": "turbo run build",
    "gen:changelog": "node ./scripts/changelog.mjs",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "turbo run lint",
    "publish:pkg": "node ./scripts/publish.mjs",
    "test": "turbo run test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "format": "oxfmt .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@bassist/changelog": "^0.3.0",
    "@bassist/build-config": "^0.2.0",
    "@bassist/commit": "^0.1.1",
    "@bassist/oxc-integration": "^0.1.4",
    "@tsdown/css": "^0.21.9",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "turbo": "^2.9.6"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --config eslint.config.js"
    ]
  }
}
