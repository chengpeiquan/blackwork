{
  "name": "@blackwork/docs-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "build:search": "node ./scripts/build-search-index.mjs",
    "build:static": "NEXT_OUTPUT=export NEXT_DIST_DIR=.next-static next build && pnpm run build:search",
    "start": "NEXT_DIST_DIR=.next-build next start --port 4200",
    "start:static": "pnpm dlx serve .next-static --listen 4200",
    "lint": "pnpm -C ../.. exec eslint --config eslint.config.js apps/docs-starter --ignore-pattern 'apps/docs-starter/.next*'",
    "test": "vitest run"
  },
  "dependencies": {
    "@bassist/utils": "^0.17.0",
    "@blackwork/docs": "workspace:*",
    "@blackwork/search": "workspace:*",
    "blackwork": "workspace:*",
    "clsx": "^2.1.1",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
