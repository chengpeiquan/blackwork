{
  "name": "blackwork",
  "version": "0.10.0",
  "description": "Blackwork Tattoo style React UI layout for blogs, documentation sites, and other content-driven websites.",
  "author": "chengpeiquan <chengpeiquan@chengpeiquan.com>",
  "homepage": "https://chengpeiquan.com",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "tailwind-config": [
        "./dist/tailwind-config.d.ts"
      ],
      "icons": [
        "./dist/icons.d.ts"
      ],
      "form": [
        "./dist/form.d.ts"
      ],
      "rsc": [
        "./dist/rsc.d.ts"
      ],
      "*": [
        "./dist/index.d.ts",
        "./dist/*"
      ]
    }
  },
  "exports": {
    "./ui-globals.css": "./dist/ui-globals.css",
    "./tailwind-config": {
      "import": {
        "types": "./dist/tailwind-config.d.mts",
        "default": "./dist/tailwind-config.mjs"
      },
      "require": {
        "types": "./dist/tailwind-config.d.cts",
        "default": "./dist/tailwind-config.cjs"
      }
    },
    "./icons": {
      "import": {
        "types": "./dist/icons.d.mts",
        "default": "./dist/icons.mjs"
      },
      "require": {
        "types": "./dist/icons.d.cts",
        "default": "./dist/icons.cjs"
      }
    },
    "./form": {
      "import": {
        "types": "./dist/form.d.mts",
        "default": "./dist/form.mjs"
      },
      "require": {
        "types": "./dist/form.d.cts",
        "default": "./dist/form.cjs"
      }
    },
    "./rsc": {
      "import": {
        "types": "./dist/rsc.d.mts",
        "default": "./dist/rsc.mjs"
      },
      "require": {
        "types": "./dist/rsc.d.cts",
        "default": "./dist/rsc.cjs"
      }
    },
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "react ui",
    "react component",
    "shadcn ui",
    "react layout"
  ],
  "scripts": {
    "build": "run-s build:*",
    "build:lib": "tsdown",
    "build:rename": "tsx ./scripts/rename.ts",
    "diff": "npx shadcn-ui diff",
    "lint": "pnpm -C ../.. exec eslint --config eslint.config.js packages/blackwork/src",
    "prepack": "pnpm build",
    "format": "oxfmt ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengpeiquan/blackwork.git"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "react-resizable-panels": "^3.0.6",
    "sonner": "^1.7.4"
  },
  "peerDependencies": {
    "@bassist/utils": ">=0.16.0",
    "@hookform/resolvers": ">=3.0.0",
    "clsx": ">=2.1.1",
    "react": ">=19.0.0",
    "react-hook-form": ">=7.0.0",
    "tailwind-merge": ">=2.5.2",
    "tailwindcss": ">=3.4.4",
    "tailwindcss-animate": ">=1.0.7"
  },
  "peerDependenciesMeta": {
    "@hookform/resolvers": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bassist/build-config": "^0.2.0",
    "@bassist/changelog": "^0.3.0",
    "@bassist/commit": "^0.1.1",
    "@bassist/eslint-config": "^0.4.1",
    "@bassist/oxc-integration": "^0.1.4",
    "@bassist/node-utils": "^0.5.0",
    "@bassist/release": "^0.3.1",
    "@bassist/tsconfig": "^0.1.1",
    "@bassist/utils": "^0.16.0",
    "@hookform/resolvers": "^3.10.0",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "clsx": "^2.1.1",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^9.39.4",
    "npm-run-all2": "^7.0.2",
    "react": "^19.2.3",
    "react-hook-form": "^7.70.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsdown": "^0.21.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
