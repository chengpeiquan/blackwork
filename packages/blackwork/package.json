{
  "name": "blackwork",
  "version": "0.12.1",
  "description": "Blackwork Tattoo style React UI layout for blogs, documentation sites, and other content-driven websites.",
  "author": "chengpeiquan <chengpeiquan@chengpeiquan.com>",
  "homepage": "https://ui.chengpeiquan.com",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "form": [
        "./dist/form.d.ts"
      ],
      "rsc": [
        "./dist/rsc.d.ts"
      ],
      "*": [
        "./dist/index.d.ts",
        "./dist/*"
      ]
    }
  },
  "exports": {
    "./theme.css": "./dist/theme.css",
    "./ui-globals.css": "./dist/ui-globals.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./form": {
      "import": {
        "types": "./dist/form.d.mts",
        "default": "./dist/form.mjs"
      },
      "require": {
        "types": "./dist/form.d.cts",
        "default": "./dist/form.cjs"
      }
    },
    "./rsc": {
      "import": {
        "types": "./dist/rsc.d.mts",
        "default": "./dist/rsc.mjs"
      },
      "require": {
        "types": "./dist/rsc.d.cts",
        "default": "./dist/rsc.cjs"
      }
    },
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "react ui",
    "react component",
    "shadcn ui",
    "react layout"
  ],
  "scripts": {
    "build": "run-s build:*",
    "build:lib": "tsdown",
    "build:rename": "tsx ./scripts/rename.ts",
    "diff": "npx shadcn-ui diff",
    "lint": "pnpm -C ../.. exec eslint --config eslint.config.js packages/blackwork/src",
    "prepack": "pnpm build",
    "test": "node --test test/*.test.mjs && vitest run",
    "format": "oxfmt ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chengpeiquan/blackwork",
    "directory": "packages/blackwork"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.31.0",
    "react-resizable-panels": "^3.0.6",
    "sonner": "^1.7.4",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "@bassist/utils": ">=0.17.0",
    "@tanstack/react-form": ">=1.0.0",
    "clsx": ">=2.1.1",
    "react": ">=19.0.0",
    "tailwind-merge": ">=2.5.2",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-form": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bassist/build-config": "^0.2.0",
    "@bassist/changelog": "^0.3.0",
    "@bassist/commit": "^0.1.1",
    "@bassist/node-utils": "^0.5.0",
    "@bassist/release": "^0.3.1",
    "@bassist/tsconfig": "^0.1.1",
    "@bassist/utils": "^0.17.0",
    "@tanstack/react-form": "^1.33.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "clsx": "^2.1.1",
    "conventional-changelog-cli": "^5.0.0",
    "eslint": "^10.8.1",
    "npm-run-all2": "^8.0.4",
    "react": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.21.10",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
