{
  "$schema": "https://preset.js.org/schema/preset.schema.json",
  "version": 1,
  "source": {
    "repo": "https://github.com/chengpeiquan/blackwork.git",
    "directory": "apps/docs-starter"
  },
  "exclude": [
    "src/app/__tests__",
    "src/mdx/components/callout.test.ts",
    "src/mdx/components/fade-preview.test.ts",
    "src/mdx/components/rail-scroll-state.test.ts",
    "vitest.config.ts"
  ],
  "write": [
    {
      "path": "README.md",
      "lines": [
        "# Blackwork Docs",
        "",
        "A documentation site powered by Blackwork.",
        "",
        "## Development",
        "",
        "```bash",
        "pnpm install",
        "pnpm dev",
        "```",
        "",
        "Open http://localhost:3300.",
        "",
        "## Build and preview",
        "",
        "```bash",
        "pnpm build",
        "pnpm start",
        "```",
        "",
        "The static site and search index are generated in `.next-static`.",
        "Preview the built site at http://localhost:4300 to check search.",
        "",
        "## Configuration",
        "",
        "- Edit `docs.config.ts` to configure the site and theme.",
        "- Edit `content.config.ts` to configure locales and sections.",
        "- Add Markdown and MDX pages under `src/contents/<locale>/`.",
        "",
        "Read the [Blackwork documentation](https://ui.chengpeiquan.com/) and",
        "[Create Preset guide](https://preset.js.org/guide/preset-configs/)."
      ]
    }
  ],
  "json": [
    {
      "path": "package.json",
      "value": {
        "scripts": {
          "dev": "next dev --port 3300",
          "build": "NEXT_OUTPUT=export NEXT_DIST_DIR=.next-static next build && pnpm run build:search",
          "build:search": "node ./scripts/build-search-index.mjs",
          "start": "pnpm dlx serve .next-static --listen 4300",
          "lint": "tsc --noEmit",
          "build:static": null,
          "start:static": null,
          "test": null
        },
        "devDependencies": {
          "@vitejs/plugin-react": null,
          "vitest": null
        }
      }
    }
  ],
  "packageJson": {
    "resolveWorkspace": true
  }
}
